      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.010372 -0.020072 -0.000025" rpy="0 0 0"/>
      <mass value="0.002482"/>
      <inertia ixx="0.000000726" ixy="0.000000196" ixz="0.000000001" iyy="0.000000219" iyz="-0.000000001" izz="0.000000907"/>
    </inertial>
  </link>

  <!-- Fusion axis point (-34.2225, -12.3970, 13.3667) mm -> link_2dof frame -->
  <joint name="gear_1_joint" type="revolute">
    <parent link="link_2dof"/>
    <child  link="link_gear_1"/>
    <origin xyz="-0.053913 0.065516 -0.011163" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-0.5236" upper="0.5236" effort="2.0" velocity="3.0"/>
    <dynamics damping="0.005" friction="0.005"/>
  </joint>

  <!-- Fusion axis point (-52.7100, -12.5496, 13.6033) mm -> link_2dof frame -->
  <joint name="gear_2_joint" type="revolute">
    <parent link="link_2dof"/>
    <child  link="link_gear_2"/>
    <origin xyz="-0.054149 0.065669 0.007325" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-0.5236" upper="0.5236" effort="2.0" velocity="3.0"/>
    <dynamics damping="0.005" friction="0.005"/>
    <!-- single-encoder alternative (1:1 mesh, opposite sense):
    <mimic joint="gear_1_joint" multiplier="-1.0" offset="0.0"/> -->
  </joint>

