  <!-- joint6 이후(그리퍼 전체)를 툴 축 둘레로 180도 돌립니다.
       CAD 익스포트가 실물과 반대로 나와서 넣었습니다.

       축을 Z 로 고른 근거는 끝단 위치입니다. X 나 Y 로 돌리면 끝단이
       플랜지 **뒤**(x = -0.03)로 가서 그리퍼가 팔을 향합니다:

         회전 없음   끝단 [+0.159 -0.027 +0.232]
         Z 180도     끝단 [+0.161 +0.027 +0.213]   <- 앞으로 뻗고 좌우만 뒤집힘
         X 180도     끝단 [-0.029 +0.027 +0.215]   뒤를 향함
         Y 180도     끝단 [-0.027 -0.027 +0.196]   뒤를 향함

       주의: 이건 **프레임 자체**를 돌리므로 아래 두 조인트의 축
       (-1 0 0 / 0 1 0) 도 월드에서 반대 방향이 됩니다. 그래서 손으로
       돌렸을 때 화면이 반대로 돌 수 있습니다. 그건 URDF 를 또 고치지 말고
       wrist_gravity.py 의 s7=-1 / s8=-1 로 맞추세요; 부호는 배선의
       사실이라 실행 인자 쪽이 제자리입니다. -->
  <joint name="link6_to_link_1dof" type="fixed">
    <parent link="link6"/>
    <child  link="link_1dof"/>
    <origin xyz="-0.0000571791 0.0000250444 0.0099998" rpy="0 0 3.14159265"/>
  </joint>

  <joint name="link_1dof_2dof_joint" type="revolute">
    <parent link="link_1dof"/>
    <child  link="link_1dof_2dof"/>
    <origin xyz="0.084758 0.000154 0.093298" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="5.0" velocity="3.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <joint name="link_2dof_joint" type="revolute">
    <parent link="link_1dof_2dof"/>
    <child  link="link_2dof"/>
    <origin xyz="-0.084454 -0.072154 0.001702" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="5.0" velocity="3.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>



  <!-- ============== added: hand-driven gripper finger gears ==============
       The two finger levers were separated out of link_2dof in Fusion
       ("gripper add 2dof v5") into their own components. Module-1 spur gears,
       1:1 external mesh, pitch r 9.244 mm, centre distance 18.488 mm.
       These are input joints: the operator squeezes the levers and the joint
       values are what gets read back, nothing drives them.

       Both rotate about link_2dof -X (Fusion +Z). Being a 1:1 external mesh
       they counter-rotate, so gear_2 = -gear_1 exactly; gear_2_joint is left
       independent for a second encoder, or use the <mimic> shown below it.

       link_2dof's <inertial> was recomputed for the housing alone. The three
       masses still sum to 0.055048 kg, what link_2dof carried before.

       Meshes to export from Fusion (mm, component origin):
         link_2dof.stl  -> RE-EXPORT, housing only now
         gear_1.stl     -> body GEAR_1 in component link_gear_1
         gear_2.stl     -> body GEAR_2 in component link_gear_2
       ===================================================================== -->

  <link name="link_gear_1">
    <visual>
      <origin xyz="0.013367 -0.012397 -0.034223" rpy="0.000000 1.570796 3.141593"/>
      <geometry>
        <mesh filename="file:///home/medisc/Downloads/link_gear_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0.013367 -0.012397 -0.034223" rpy="0.000000 1.570796 3.141593"/>
      <geometry>
        <mesh filename="file:///home/medisc/Downloads/link_gear_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.010063 -0.020209 0.000565" rpy="0 0 0"/>
      <mass value="0.002480"/>
      <inertia ixx="0.000000731" ixy="0.000000188" ixz="-0.000000006" iyy="0.000000214" iyz="0.000000019" izz="0.000000906"/>
    </inertial>
  </link>

  <link name="link_gear_2">
    <visual>
      <origin xyz="0.013603 -0.012550 -0.052710" rpy="0.000000 1.570796 3.141593"/>
      <geometry>
        <mesh filename="file:///home/medisc/Downloads/link_gear_2.stl" scale="0.001 0.001 0.001"/>
